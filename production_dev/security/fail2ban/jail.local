[DEFAULT]
bantime = 1h
findtime = 10m
maxretry = 6
ignoreip = 127.0.0.1/8 ::1

[ostrofun-nginx-botsearch]
enabled = true
port = 80,443,9742
filter = nginx-botsearch
logpath = /home/user/GROM/ostrofun/security/nginx-logs/access.log
maxretry = 2
findtime = 10m
bantime = 24h

[ostrofun-nginx-limit-req]
enabled = true
port = 80,443,9742
filter = nginx-limit-req
logpath = /home/user/GROM/ostrofun/security/nginx-logs/error.log
maxretry = 10
findtime = 5m
bantime = 1h
