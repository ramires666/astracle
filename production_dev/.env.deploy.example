# Image tags loaded on target server (docker load / pull)
BACKEND_IMAGE=ostrofun-backend:latest
FRONTEND_IMAGE=ostrofun-frontend:latest

# Public HTTP port for frontend container (host:container80)
PUBLIC_PORT=9742

# Host folder for persistent storage (relative to compose file dir)
STORAGE_ROOT=./storage

# Runtime toggles
ALLOW_LEGACY_MODEL_FALLBACK=0
LIVE_REFRESH_ENABLED=1
LIVE_REFRESH_INTERVAL_SECONDS=30
LIVE_REFRESH_PRICE_MOVE_THRESHOLD=0.03
MARKET_UPDATE_ALLOW_BINANCE_FALLBACK=0

# Optional CoinGecko key (recommended to reduce rate limits)
COINGECKO=
